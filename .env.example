# opencoder - environment for self-hosting
# Copy to .env, edit, then `docker compose up --build`.

# The port your friends should hit. Change to anything you like.
PORT=4000

# Public URL used in invite links. Use your LAN IP / tunnel / domain.
PUBLIC_BASE_URL=http://localhost:4000

# REQUIRED. A random 32+ char string. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=please-set-me-to-a-long-random-secret

# Where the SQLite DB lives inside the container. The compose volume
# `opencoder_data` is mounted at /data, so this path persists.
DATABASE_URL=file:/data/opencoder.db

# If false (default), the api will use Docker-sandboxed code execution
# when /var/run/docker.sock is mounted. Set to true to skip Docker.
EXEC_FORCE_LOCAL=false
